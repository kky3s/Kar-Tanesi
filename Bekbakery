            },
            {
                id: 19,
                name: "Çocuklar İçin Ballı & Tarçınlı Sıcak Süt",
                category: "Sıcak & Soğuk İçecekler",
                price: 115,
                badge: "👶 Miniklere Özel",
                familyTag: "👶 Çocuklar İçin Çok Uygun",
                desc: "Ilık günlük süt, doğal yayla çiçek balı ve üzerinde hafif Seylan tarçını dokunuşuyla içimi yumuşacık süt.",
                story: "Anne ve babalar kahvelerini yudumlarken küçük misafirlerimizin de kendilerine özel sıcacık bir kupası olsun istedik. Sütü çocukların ağzını yakmayacak ılık derecede hazırlıyor, doğal çiçek balıyla tatlandırıyoruz.",
                ingredients: "Günlük pastörize tam yağlı süt, doğal çiçek balı, isteğe bağlı toz tarçın.",
                allergens: ["Süt ve Süt Ürünleri"],
                allergyNote: "1 yaş altı bebekler için balsız (sade ılık süt) olarak veya bitkisel sütle hazırlanabilir.",
                image: "https://images.unsplash.com/photo-1517701550927-30cf4ba1dba5?auto=format&fit=crop&w=600&q=80"
            }
        ];

        // Gerçek Misafir Yorumları (Samimi Aile & Komşu Deneyimleri)
        const guestReviews = [
            {
                author: "Erdem Aydın",
                rating: 5,
                badge: "Protein Kahvaltı • 450 ₺",
                date: "Ailece Hafta Sonu Kahvaltısı",
                text: "Çok samimi ve sıcak bir mekan, çalışanlar aileden biri gibi güler yüzlü. Protein kahvaltı 450 TL, hem çok doyurucu hem de kullanılan ekmek ve peynirler çok taze. Gönül rahatlığıyla tavsiye ederim."
            },
            {
                author: "Arzu Çelik",
                rating: 5,
                badge: "Huzurlu Atmosfer & Tatlılar",
                date: "Konyaaltı Komşumuz",
                text: "İçeri girdiğiniz anda evinizdeymişsiniz gibi huzurlu bir havası var. Çocuklarla bahçede oturmak çok rahat, tatlıları ve kahveleri harika. Saatlerce sıkılmadan vakit geçirebileceğiniz bir yer."
            },
            {
                author: "Semih Soylu",
                rating: 5,
                badge: "Taş Fırın Ekmekleri & Pastane",
                date: "Düzenli Misafirimiz",
                text: "Konyaaltı'nda ailecek gidilebilecek en temiz ve özenli fırın-kafe. Özellikle domatesli siyez ekmeği ve sıcak kruvasanları bağımlılık yapıyor, her şey mükemmel."
            },
            {
                author: "Sevilay Güner",
                rating: 5,
                badge: "Ferah Bahçe & Mama Sandalyesi",
                date: "Çocuklu Aile Ziyareti",
                text: "Geniş, ferah ve çocuklu aileler için çok düşünceli tasarlanmış bir mekan. Bebek arabasıyla rahatça girdik, mama sandalyesi hemen geldi. Ekşi mayalı ürünleri çocuklarımıza güvenle yedirdik."
            }
        ];

        let activeCategory = "Tümü";
        let billItems = [];
        let splitCount = 1;
        let splitLabelText = "1 Kişi";

        // Canlı Açık/Kapalı Durumu (07:00 - 23:00)
        function updateLiveOpenStatus() {
            const now = new Date();
            const hour = now.getHours();
            const badge = document.getElementById('live-status-badge');
            if (!badge) return;

            if (hour >= 7 && hour < 23) {
                badge.innerHTML = `
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Fırınımız Sıcak & Açık • Her Gün 07:00 – 23:00</span>
                `;
            } else {
                badge.innerHTML = `
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <span>Sabah 07:00'de Sıcak Ekmeklerimizle Açılıyoruz</span>
                `;
            }
        }

        // Menüyü Render Etme (Karta Tıklanınca Hikaye & Alerjen Modalı Açılır)
        function renderMenuItems() {
            const query = document.getElementById('menu-search-input').value.toLowerCase().trim();
            const grid = document.getElementById('menu-items-grid');
            const label = document.getElementById('menu-count-label');

            const filtered = menuData.filter(item => {
                const matchCat = activeCategory === "Tümü" || item.category === activeCategory;
                const matchSearch = item.name.toLowerCase().includes(query) ||
                                    item.desc.toLowerCase().includes(query) ||
                                    item.story.toLowerCase().includes(query) ||
                                    item.category.toLowerCase().includes(query);
                return matchCat && matchSearch;
            });

            label.textContent = `${filtered.length} doğal lezzet listeleniyor`;

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="sm:col-span-2 bg-warmwhite p-10 rounded-3xl text-center border border-espresso/10">
                        <i class="fa-solid fa-wheat-awn text-crust text-2xl mb-2"></i>
                        <p class="font-bold text-espresso">Aradığınız lezzet bulunamadı.</p>
                        <button onclick="setMenuCategory('Tümü'); document.getElementById('menu-search-input').value=''; renderMenuItems();" class="mt-2 text-xs text-crust underline font-semibold">Tüm menüyü göster</button>
                    </div>
                `;
                return;
            }

            grid.innerHTML = filtered.map(item => {
                const allergenPreview = item.allergens[0] === "Bilinen Alerjen İçermez"
                    ? `<span class="text-[10px] font-semibold text-sage-dark bg-sage-light px-2 py-0.5 rounded-md">✓ Alerjen İçermez</span>`
                    : `<span class="text-[10px] font-medium text-espresso-muted bg-alabaster px-2 py-0.5 rounded-md border border-espresso/10"><i class="fa-solid fa-shield-heart text-crust mr-1"></i>${item.allergens.length} Alerjen Bilgisi</span>`;

                return `
                <div onclick="openItemModal(${item.id})" class="bg-warmwhite rounded-2xl p-4 border border-espresso/10 card-artisan flex flex-col justify-between shadow-sm cursor-pointer group">
                    <div class="flex gap-3.5 items-start">
                        <div class="relative shrink-0">
                            <img src="${item.image}" 
                                 onerror="this.src='https://placehold.co/200x200/F4ECE1/3A261D?text=Bek+Bakery'"
                                 alt="${item.name}" 
                                 class="w-24 h-24 rounded-xl object-cover border border-espresso/10 group-hover:scale-105 transition duration-300">
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <span class="inline-block text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-parchment text-crust mb-1">${item.badge}</span>
                                    <h4 class="font-serif-heading text-base sm:text-lg font-bold text-espresso group-hover:text-crust transition leading-snug">${item.name}</h4>
                                </div>
                                <span class="font-serif-heading font-bold text-base sm:text-lg text-crust shrink-0">${item.price} ₺</span>
                            </div>
                            <p class="text-xs text-espresso-soft mt-1 line-clamp-2 leading-relaxed">${item.desc}</p>
                        </div>
                    </div>

                    <div class="mt-3.5 pt-2.5 border-t border-espresso/10 flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class="text-[11px] font-bold text-crust group-hover:underline flex items-center gap-1">
                                <i class="fa-solid fa-book-open"></i> Hikayesi & Alerjenler
                            </span>
                            ${allergenPreview}
                        </div>
                        <button onclick="event.stopPropagation(); addItemToBill(${item.id})" class="px-3 py-1.5 rounded-xl bg-parchment hover:bg-crust hover:text-white text-espresso text-xs font-bold transition flex items-center gap-1 shrink-0">
                            <i class="fa-solid fa-plus text-[10px]"></i> Sofraya Ekle
                        </button>
                    </div>
                </div>
            `}).join('');
        }

        // Ürün Hikayesi ve Alerjen Detay Modalını Açma
        function openItemModal(id) {
            const item = menuData.find(m => m.id === id);
            if (!item) return;

            document.getElementById('modal-item-img').src = item.image;
            document.getElementById('modal-item-img').alt = item.name;
            document.getElementById('modal-item-cat').textContent = item.category;
            document.getElementById('modal-item-family-tag').textContent = item.familyTag;
            document.getElementById('modal-item-title').textContent = item.name;
            document.getElementById('modal-item-price').textContent = `${item.price} ₺`;
            document.getElementById('modal-item-story').textContent = item.story;
            document.getElementById('modal-item-ingredients').textContent = item.ingredients;
            document.getElementById('modal-item-allergy-note').textContent = item.allergyNote;

            const allergensContainer = document.getElementById('modal-item-allergens');
            allergensContainer.innerHTML = item.allergens.map(al => {
                if (al === "Bilinen Alerjen İçermez") {
                    return `<span class="px-3 py-1 rounded-full bg-sage text-white text-xs font-bold flex items-center gap-1.5"><i class="fa-solid fa-check"></i> ${al}</span>`;
                }
                return `<span class="px-3 py-1 rounded-full bg-warmwhite border border-crust/40 text-espresso text-xs font-bold flex items-center gap-1.5"><i class="fa-solid fa-wheat-awn text-crust"></i> ${al}</span>`;
            }).join('');

            const addBtn = document.getElementById('modal-add-btn');
            addBtn.onclick = function() {
                addItemToBill(item.id);
                closeItemModal();
            };

            document.getElementById('item-detail-modal').classList.remove('hidden');
        }

        function closeItemModal() {
            document.getElementById('item-detail-modal').classList.add('hidden');
        }

        // Deneyimler Bölümü Merak Kutusu ("Biliyor muydunuz?") Aç/Kapa
        function toggleCuriosity(num) {
            const box = document.getElementById(`curiosity-${num}`);
            if (!box) return;
            box.classList.toggle('hidden');
        }

        function setMenuCategory(cat) {
            activeCategory = cat;
            document.querySelectorAll('.menu-cat-btn').forEach(btn => {
                if (btn.getAttribute('data-cat') === cat) {
                    btn.className = "menu-cat-btn px-4 py-2.5 rounded-full text-xs sm:text-sm font-bold bg-espresso text-white transition shrink-0";
                } else {
                    btn.className = "menu-cat-btn px-4 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-parchment text-espresso-soft hover:text-espresso transition shrink-0";
                }
            });
            renderMenuItems();
        }

        // Masa Defterim İşlevleri
        function addItemToBill(id) {
            const product = menuData.find(m => m.id === id);
            if (!product) return;

            const existing = billItems.find(b => b.id === id);
            if (existing) {
                existing.qty += 1;
            } else {
                billItems.push({ ...product, qty: 1 });
            }
            updateBillUI();
            showToast(`"${product.name}" Masa Defterinize eklendi (${product.price} ₺)`);
        }

        function changeBillQty(id, delta) {
            const idx = billItems.findIndex(b => b.id === id);
            if (idx === -1) return;
            billItems[idx].qty += delta;
            if (billItems[idx].qty <= 0) {
                billItems.splice(idx, 1);
            }
            updateBillUI();
        }

        function clearBill() {
            billItems = [];
            updateBillUI();
        }

        function setSplitCount(count, labelText) {
            splitCount = count;
            splitLabelText = labelText || `${count} Kişi`;
            document.querySelectorAll('.split-btn').forEach(btn => {
                if (parseInt(btn.getAttribute('data-s')) === count) {
                    btn.className = "split-btn px-2.5 py-2 rounded-xl text-[11px] font-bold bg-espresso text-white transition";
                } else {
                    btn.className = "split-btn px-2.5 py-2 rounded-xl text-[11px] font-bold bg-warmwhite text-espresso border border-espresso/10 transition";
                }
            });
            updateBillUI();
        }

        function updateBillUI() {
            const totalQty = billItems.reduce((sum, i) => sum + i.qty, 0);
            const totalPrice = billItems.reduce((sum, i) => sum + (i.price * i.qty), 0);
            const perPerson = Math.round(totalPrice / splitCount);

            document.getElementById('bill-badge-count').textContent = totalQty;
            document.getElementById('sticky-bill-total').textContent = `${totalPrice.toLocaleString('tr-TR')} ₺`;
            document.getElementById('sticky-per-person').textContent = `${perPerson.toLocaleString('tr-TR')} ₺ / kişi`;

            document.getElementById('drawer-total').textContent = `${totalPrice.toLocaleString('tr-TR')} ₺`;
            document.getElementById('drawer-split-count').textContent = splitLabelText;
            document.getElementById('drawer-per-person').textContent = `${perPerson.toLocaleString('tr-TR')} ₺ / kişi`;

            const emptyHtml = `
                <div class="text-center py-6 text-xs text-espresso-muted">
                    <i class="fa-solid fa-utensils text-crust text-lg mb-1.5 block"></i>
                    Masa defteriniz henüz boş. Menüden <strong>"+ Sofraya Ekle"</strong> butonuna tıklayarak aileniz için seçtiklerinizi buraya ekleyebilirsiniz.
                </div>
            `;

            const listHtml = billItems.map(item => `
                <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-alabaster border border-espresso/10 text-xs">
                    <div class="min-w-0 flex-1">
                        <div class="font-bold text-espresso truncate">${item.name}</div>
                        <div class="text-espresso-muted">${item.price} ₺ x ${item.qty}</div>
                    </div>
                    <div class="flex items-center gap-1.5 shrink-0">
                        <button onclick="changeBillQty(${item.id}, -1)" class="w-6 h-6 rounded-md bg-parchment hover:bg-espresso hover:text-white font-bold">-</button>
                        <span class="w-4 text-center font-bold">${item.qty}</span>
                        <button onclick="changeBillQty(${item.id}, 1)" class="w-6 h-6 rounded-md bg-parchment hover:bg-espresso hover:text-white font-bold">+</button>
                        <span class="font-bold text-crust ml-1 w-14 text-right">${item.price * item.qty} ₺</span>
                    </div>
                </div>
            `).join('');

            document.getElementById('sticky-bill-list').innerHTML = billItems.length ? listHtml : emptyHtml;
            document.getElementById('drawer-bill-items').innerHTML = billItems.length ? listHtml : emptyHtml;
        }

        function toggleBillDrawer() {
            document.getElementById('bill-drawer').classList.toggle('hidden');
        }

        function transferBillToBooking() {
            if (billItems.length > 0) {
                const summary = billItems.map(i => `${i.qty}x ${i.name}`).join(', ');
                const total = billItems.reduce((sum, i) => sum + (i.price * i.qty), 0);
                document.getElementById('book-notes').value = `Masa Defterim Listesi (${total} ₺): ${summary}`;
                showToast("Seçtiğiniz lezzetler rezervasyon notunuza eklendi!");
            }
            document.getElementById('rezervasyon').scrollIntoView({ behavior: 'smooth' });
        }

        // Misafir Yorumlarını Render Etme
        function renderGuestReviews() {
            const container = document.getElementById('guest-reviews-grid');
            container.innerHTML = guestReviews.map(r => {
                const stars = Array.from({ length: r.rating }, () => '<i class="fa-solid fa-star"></i>').join('');
                return `
                    <div class="bg-warmwhite p-6 rounded-3xl border border-espresso/10 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between gap-2 mb-3">
                                <div class="flex text-crust text-xs gap-1">${stars}</div>
                                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-parchment text-espresso">${r.badge}</span>
                            </div>
                            <p class="text-xs sm:text-sm text-espresso-soft leading-relaxed italic">"${r.text}"</p>
                        </div>
                        <div class="mt-4 pt-3 border-t border-espresso/10 flex items-center justify-between text-xs">
                            <span class="font-bold text-espresso">${r.author}</span>
                            <span class="text-espresso-muted">${r.date}</span>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleReviewModal() {
            document.getElementById('review-modal').classList.toggle('hidden');
        }

        function submitNewGuestReview(e) {
            e.preventDefault();
            const author = document.getElementById('rev-author').value;
            const rating = parseInt(document.getElementById('rev-rating').value);
            const badge = document.getElementById('rev-badge').value || "Aile Misafirimiz";
            const text = document.getElementById('rev-text').value;

            guestReviews.unshift({
                author,
                rating,
                badge,
                date: "Yeni Paylaşıldı",
                text
            });

            renderGuestReviews();
            toggleReviewModal();
            e.target.reset();
            showToast("Güzel yorumunuz için yürekten teşekkür ederiz!");
        }

        // Rezervasyon Formu Gönderimi
        function submitBookingForm(e) {
            e.preventDefault();
            const type = document.getElementById('book-type').value;
            const name = document.getElementById('book-name').value;
            const date = document.getElementById('book-date').value;
            const time = document.getElementById('book-time').value;
            const guests = document.getElementById('book-guests').value;

            const checkedPerks = Array.from(document.querySelectorAll('input[name="familyPerks"]:checked')).map(cb => cb.value);
            const perksText = checkedPerks.length > 0 ? ` (${checkedPerks.join(', ')})` : '';

            const code = "#BEK-" + Math.floor(1000 + Math.random() * 9000);
            document.getElementById('booking-code').textContent = code;
            document.getElementById('booking-summary-text').innerHTML = `
                Sevgili <strong>${name}</strong>, <strong>${date}</strong> günü saat <strong>${time}</strong> için 
                <strong>${type}</strong> (${guests}${perksText}) kaydınız alınmıştır. Sizi ve ailenizi ağırlamak için sabırsızlanıyoruz!
            `;
            document.getElementById('booking-confirmation').classList.remove('hidden');
            showToast("Masanız / Sıcak ekmeğiniz sizin için ayrıldı!");
        }

        function toggleMobileNav() {
            const nav = document.getElementById('mobile-nav');
            const icon = document.getElementById('mobile-nav-icon');
            nav.classList.toggle('hidden');
            icon.className = nav.classList.contains('hidden') ? 'fa-solid fa-bars text-lg' : 'fa-solid fa-xmark text-lg';
        }

        function showToast(message) {
            const toast = document.getElementById('toast-notification');
            document.getElementById('toast-text').textContent = message;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3200);
        }

        window.onload = function() {
            const today = new Date().toISOString().split('T')[0];
            const dateInput = document.getElementById('book-date');
            if (dateInput) {
                dateInput.value = today;
                dateInput.min = today;
            }
            updateLiveOpenStatus();
            renderMenuItems();
            updateBillUI();
            renderGuestReviews();
        };
    </script>
</body>
</html>
